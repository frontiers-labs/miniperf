#!/usr/bin/env bash
# Compare the viewer's region hierarchy and selection against the raw recording.
# shellcheck source=checks/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"
: "${MPERF_RECORDINGS:?set MPERF_RECORDINGS to a directory of recordings}"

launch() {
    if [[ "$(uname -s)" != Linux || -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        "$@"
    else
        xvfb-run -a "$@"
    fi
}

visited=0
while IFS= read -r info; do
    dir="$(dirname "${info}")"
    [[ "$(basename "${dir}")" == rec-named-regions ]] || continue
    prefix="${CHECK_WORK}/regions-${visited}"
    launch "${mperf_gui}" --tour "${dir}" >"${prefix}.tour" 2>&1 \
        || { cat "${prefix}.tour" >&2; fail "named-region viewer tour failed"; }
    "${mperf}" query -f json "${dir}" '
      SELECT b.instance, b.pid, b.tid, b.timestamp AS start_ns,
             e.timestamp AS end_ns, s.string AS name
      FROM events b
      LEFT JOIN events e ON e."type" = 1 AND e.flow_id = b.instance AND e.pid = b.pid
      JOIN payloads p ON p.event_id = b.event_id
      JOIN strings s ON s.id = p.name_id
      WHERE b."type" = 0 ORDER BY b.timestamp' >"${prefix}.spans" \
        || fail "could not query recorded regions"
    "${mperf}" query -f json "${dir}" '
      SELECT timestamp, process_id, thread_id FROM pmu_counters' >"${prefix}.samples" \
        || fail "could not query recorded samples"
    python3 "${checks_root}/../utils/verify-named-regions.py" "${prefix}" \
        || fail "the viewer hierarchy or region filtering disagrees with the recording"
    visited=$((visited + 1))
done < <(find "${MPERF_RECORDINGS}" -name info.json)
[[ "${visited}" -gt 0 ]] || fail "no named-region recording found under ${MPERF_RECORDINGS}"
note "verified ${visited} real named-region recording(s)"

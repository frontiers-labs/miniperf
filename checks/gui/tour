#!/usr/bin/env bash
# The viewer opens every recording this run produced and renders every tab.
#
# Drives the shipped binary through its production path: the same ShellView a
# user gets, the same load, the same tab switch the click handler calls. There
# is no test-only load path to drift from it.
# shellcheck source=checks/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"
: "${MPERF_RECORDINGS:?set MPERF_RECORDINGS to a directory of recordings}"

# Tabs each scenario must offer. Expectations belong in the check; inputs come
# from the profiler.
required_for() {
    case "$1" in
        snapshot)
            printf 'Summary\nResources\n'
            if [[ "$2" == yes ]]; then
                printf 'Hotspots\nFlame Graph\n'
            fi
            ;;
        tma)      printf 'Summary\nHotspots\nTop-Down\n' ;;
        *)        printf 'Summary\n' ;;
    esac
}

# The viewer needs a real window. A developer machine already has one; CI
# supplies Xvfb and a window manager. Neither is a reason to pretend the check
# passed.
launch() {
    if [[ "$(uname -s)" != Linux ]]; then
        "$@"
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        "$@"
    else
        xvfb-run -a "${checks_root}/../utils/run-headless-gui.sh" "$@"
    fi
}

if [[ "$(uname -s)" == Linux && -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    command -v xvfb-run >/dev/null || skip "no display and no xvfb-run"
    command -v openbox >/dev/null || skip "no display and no openbox window manager"
fi

visited=0
while IFS= read -r info; do
    dir="$(dirname "${info}")"
    scenario="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["scenario"].lower())' "${info}")"
    note "touring ${scenario} (${dir})"
    prefix="${CHECK_WORK}/tour-${visited}"
    log="${prefix}.tour"
    launch "${mperf_gui}" --tour "${dir}" >"${log}" 2>&1 \
        || { cat "${log}" >&2; fail "the viewer could not display the ${scenario} recording"; }
    grep -qiE '^thread .* panicked at ' "${log}" && { cat "${log}" >&2; fail "the viewer panicked on ${scenario}"; }
    has_samples="$("${mperf}" query -f json "${dir}" 'SELECT COUNT(*) > 0 AS has_samples FROM pmu_counters' \
        | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin)["rows"][0]["has_samples"] else "no")')" \
        || fail "could not inspect samples in the ${scenario} recording"
    while IFS= read -r tab; do
        [[ -z "${tab}" ]] && continue
        grep -qF "tour: rendered ${tab}" "${log}" \
            || { cat "${log}" >&2; fail "${scenario} did not offer the ${tab} tab"; }
    done < <(required_for "${scenario}" "${has_samples}")
    if [[ "$(basename "${dir}")" == rec-rust-names-* ]]; then
        python3 "${checks_root}/../utils/verify-rust-names.py" --tour "${log}" \
            || fail "the viewer lost Rust instance identity, search, or source/assembly lookup"
    elif [[ "$(basename "${dir}")" == rec-named-regions ]]; then
        python3 "${checks_root}/../utils/verify-named-regions.py" "${prefix}" "${dir}" \
            || fail "the viewer region analysis disagrees with the recording"
    elif [[ "$(basename "${dir}")" == rec-named-regions-dense ]]; then
        python3 "${checks_root}/../utils/verify-named-regions.py" --dense "${log}" \
            || fail "dense region rendering did not stay within its pixel budget"
    fi
    python3 "${checks_root}/../utils/verify-allocation-peaks.py" "${mperf}" "${dir}" "${log}" \
        || fail "the viewer allocation sites disagree with operation-ordered recording SQL"
    visited=$((visited + 1))
done < <(find "${MPERF_RECORDINGS}" -name info.json)

[[ "${visited}" -gt 0 ]] || fail "no recordings found under ${MPERF_RECORDINGS}"
note "toured ${visited} recording(s)"

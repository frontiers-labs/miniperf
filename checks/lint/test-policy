#!/usr/bin/env bash
# Unit tests survive only in crates that cannot reach a recording.
#
# This is the structural half of "no mocks": a crate on the allowlist must not
# depend on miniperf-store or duckdb, so a hand-built pmu_counters table has no
# crate left to compile in. Everything else carries no tests at all.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
python3 utils/test-policy.py

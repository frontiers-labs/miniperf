#!/usr/bin/env bash
# Lint shell entry points and sourced shell helpers.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.." || exit 1
if ! command -v shellcheck >/dev/null; then
    # A missing tool is a skip, not a pass. Silently succeeding here is how a
    # check stops being one.
    echo "SKIP: shellcheck is not installed" >&2
    exit 3
fi
targets=()
while IFS= read -r target; do
    case "${target}" in
        *.sh) targets+=("${target}") ;;
        *)
            IFS= read -r first_line < "${target}"
            case "${first_line}" in
                '#!/usr/bin/env bash'|'#!/usr/bin/env sh'|'#!/bin/bash'|'#!/bin/sh')
                    targets+=("${target}") ;;
            esac
            ;;
    esac
done < <(git ls-files 'checks/*' 'utils/*.sh' | grep -v '^checks/fixtures/')
shellcheck --shell=bash --external-sources "${targets[@]}"

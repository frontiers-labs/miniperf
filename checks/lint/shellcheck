#!/usr/bin/env bash
# The check tree is shell, so it gets a linter.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
command -v shellcheck >/dev/null || { echo "  shellcheck not installed"; exit 0; }
mapfile -t targets < <(git ls-files 'checks/*' 'utils/*.sh' | grep -v '^checks/fixtures/')
shellcheck --shell=bash --external-sources "${targets[@]}"

#!/usr/bin/env bash
# A TMA recording produces a topdown breakdown, not just samples.
# shellcheck source=checks/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
# Not applicable without a Linux host: this check drives perf_event_open.
[[ "$(uname -s)" == Linux ]] || skip "not a Linux host"
require_pmu
dir="$(need_recording tma)"
assert_sql "${dir}" "
  SELECT COUNT(*) > 0        AS has_samples,
         SUM(pmu_cycles) > 0 AS has_cycles
  FROM pmu_counters"
note "tma recording carries hardware counters"

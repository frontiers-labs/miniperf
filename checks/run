#!/usr/bin/env bash
# Runs checks. What applies to this host is decided here, on the host.
#
#   checks/run            every package check that applies
#   checks/run lint       source checks
#   checks/run gui        viewer checks over MPERF_RECORDINGS
#   checks/run NAME ...   named checks, wherever they live
#
# Exit 3 from a check means "does not apply here" and is not a failure. Only
# the PMU oracle, which links nothing from miniperf, can cause one.
set -uo pipefail
checks_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CHECK_WORK="${CHECK_WORK:-$(mktemp -d "${TMPDIR:-/tmp}/mperf-checks.XXXXXX")}"
mkdir -p "${CHECK_WORK}/bin"

read_lines() {
    # bash 3.2, which is what macOS ships, has no mapfile.
    local __array="$1"; shift
    local __line
    eval "${__array}=()"
    while IFS= read -r __line; do
        eval "${__array}+=(\"\${__line}\")"
    done
}

resolve() {
    for candidate in "${checks_root}/$1" "${checks_root}/lint/$1" "${checks_root}/gui/$1"; do
        [[ -x "${candidate}" ]] && { printf '%s' "${candidate}"; return 0; }
    done
    return 1
}

selected=()
# shellcheck disable=SC2034  # filled by read_lines through eval
case "${1:-}" in
    ""|all)  read_lines selected < <(find "${checks_root}" -maxdepth 1 -type f -perm -u+x ! -name run | sort) ;;
    lint|gui) read_lines selected < <(find "${checks_root}/$1" -maxdepth 1 -type f -perm -u+x | sort) ;;
    *)       for name in "$@"; do
                 path="$(resolve "${name}")" || { echo "unknown check: ${name}" >&2; exit 2; }
                 selected+=("${path}")
             done ;;
esac

# Reported once, before anything runs, so a placement without counters is
# visible in the log and in the job summary rather than inferred from skips.
if [[ "$(uname -s)" == Linux && "${1:-}" != lint ]]; then
    pmu=absent
    if cc -O2 -o "${CHECK_WORK}/bin/pmu_oracle" "${checks_root}/fixtures/pmu_oracle.c" 2>/dev/null \
       && "${CHECK_WORK}/bin/pmu_oracle"; then
        pmu=present
    fi
    printf 'PMU oracle: %s\n' "${pmu}"
    [[ -n "${GITHUB_OUTPUT:-}" ]] && printf 'pmu=%s\n' "${pmu}" >> "${GITHUB_OUTPUT}"
    [[ -n "${GITHUB_STEP_SUMMARY:-}" ]] && printf -- '- PMU oracle: **%s** (%s)\n' "${pmu}" \
        "$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed 's/.*: //' || uname -m)" \
        >> "${GITHUB_STEP_SUMMARY}"
fi

# No check may run without a deadline. A hung check burns paid runner minutes
# until the job's own timeout fires, which is the difference between a 40
# second job and a 25 minute one. Implemented with a watchdog rather than
# timeout(1), which macOS does not ship.
run_with_deadline() {
    local seconds="$1"; shift
    # `set -m` gives both the check and the watchdog their own process group,
    # so each can be killed with its descendants. Killing only the leader
    # leaves a `sleep` holding the output pipe open, which is the same hang
    # wearing a hat, and it is why this function is written out rather than
    # being a call to timeout(1) that macOS does not ship anyway.
    set -m
    "$@" &
    local child=$!
    # The watchdog must not share stdout, or its own sleep keeps the pipe open.
    (
        sleep "${seconds}"
        kill -TERM -"${child}" 2>/dev/null || kill -TERM "${child}" 2>/dev/null
        sleep 5
        kill -KILL -"${child}" 2>/dev/null || kill -KILL "${child}" 2>/dev/null
    ) >/dev/null 2>&1 &
    local watchdog=$!
    set +m

    wait "${child}"
    local code=$?
    kill -TERM -"${watchdog}" 2>/dev/null || kill -TERM "${watchdog}" 2>/dev/null
    wait "${watchdog}" 2>/dev/null
    return "${code}"
}

status=0
for path in "${selected[@]}"; do
    name="$(basename "${path}")"
    printf '\n== %s\n' "${name}"
    run_with_deadline "${CHECK_TIMEOUT_SECONDS:-300}" "${path}"
    case $? in
        0) printf 'ok: %s\n' "${name}" ;;
        3) printf 'skipped: %s\n' "${name}" ;;
        143|137) printf 'FAILED: %s (exceeded %ss and was killed)\n' \
                    "${name}" "${CHECK_TIMEOUT_SECONDS:-300}"; status=1 ;;
        *) printf 'FAILED: %s\n' "${name}"; status=1 ;;
    esac
done
exit "${status}"

#!/usr/bin/env bash
# Exercise the real control plane against malformed and explicit wire bytes.
set -euo pipefail
case "$(uname -s)" in
    Linux|Darwin) ;;
    *) printf 'control protocol uses POSIX shared memory; no check on this host\n'; exit 0 ;;
esac
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work="${CHECK_WORK:-$(mktemp -d "${TMPDIR:-/tmp}/mperf-control.XXXXXX")}/control-protocol"
mkdir -p "${work}"
cargo build --locked --manifest-path "${root}/Cargo.toml" -p shmem --target-dir "${work}/target"
rustc --edition 2024 "${root}/checks/fixtures/control_protocol.rs" \
    -L "dependency=${work}/target/debug/deps" \
    --extern "shmem=${work}/target/debug/libshmem.rlib" \
    -o "${work}/control-protocol"
"${work}/control-protocol"

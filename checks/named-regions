#!/usr/bin/env bash
# Record nested, repeated, recursive and unfinished regions through the shipped API.
# shellcheck source=checks/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
[[ "$(uname -s)" == Linux ]] || skip "not a Linux host"
require_pmu

traced="${CHECK_WORK}/bin/named_regions"
cc -O2 -g -fno-omit-frame-pointer -pthread -I "${MPERF_PACKAGE}/include" \
    -o "${traced}" "${checks_root}/fixtures/named_regions.c" \
    "${MPERF_PACKAGE}/share/miniperf/mperf_trace_stub.c" -ldl \
    || fail "the named-region workload did not compile"
dir="${CHECK_WORK}/rec-named-regions"
"${mperf}" record -s snapshot -o "${dir}" -- "${traced}" >"${dir}.log" 2>&1 \
    || { cat "${dir}.log" >&2; fail "named-region recording failed"; }
assert_sql "${dir}" "
  SELECT SUM(count) FILTER (WHERE kind = 'span') = 13 AS every_completed_span,
         SUM(count) FILTER (WHERE name = 'iteration') = 4 AS repeated_calls,
         SUM(count) FILTER (WHERE name = 'compute') = 5 AS shared_child,
         SUM(count) FILTER (WHERE name = 'recursive') = 2 AS recursive_calls
  FROM custom_events"
assert_sql "${dir}" '
  SELECT COUNT(*) FILTER (WHERE "type" = 0) = 14 AS every_begin,
         COUNT(*) FILTER (WHERE "type" = 1) = 13 AS every_end,
         COUNT(DISTINCT tid) = 2 AS both_threads
  FROM events'
note "recorded named-region hierarchy for the viewer checks"

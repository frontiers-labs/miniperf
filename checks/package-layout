#!/usr/bin/env bash
# The package contains what users and every later check depend on.
# shellcheck source=checks/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
platform="$(cat "${MPERF_PACKAGE}/MANIFEST.txt" >/dev/null 2>&1 && echo ok || echo missing)"
[[ "${platform}" == ok ]] || fail "MANIFEST.txt missing from ${MPERF_PACKAGE}"
for relative in share/doc/miniperf/README.md share/doc/miniperf/LICENSE; do
    [[ -f "${MPERF_PACKAGE}/${relative}" ]] || fail "missing ${relative}"
done
if [[ "$(uname -s)" == Linux ]]; then
    for relative in bin/mperf lib/miniperf/libmperf_collector.so lib/miniperf/libmperf_libc.so; do
        [[ -e "${MPERF_PACKAGE}/${relative}" ]] || fail "missing ${relative}"
    done
fi
note "package layout ok"

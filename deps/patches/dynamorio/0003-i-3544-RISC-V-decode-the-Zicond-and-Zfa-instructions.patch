diff --git a/core/ir/riscv64/isl/zfa.txt b/core/ir/riscv64/isl/zfa.txt
new file mode 100644
index 000000000..9017bf671
--- /dev/null
+++ b/core/ir/riscv64/isl/zfa.txt
@@ -0,0 +1,36 @@
+# "Zfa" Standard Extension for Additional Floating-Point Instructions.
+# Version 1.0
+#
+# The half and quad forms are decodable whether or not the host implements
+# Zfh or Q: a decoder that only knows the formats it expects to see turns an
+# unexpected one into SIGILL for the application.
+
+fli.s       | r | fli_imm rd(fp)          | 111100000001.....000.....1010011
+fli.d       | r | fli_imm rd(fp)          | 111100100001.....000.....1010011
+fli.h       | r | fli_imm rd(fp)          | 111101000001.....000.....1010011
+fli.q       | r | fli_imm rd(fp)          | 111101100001.....000.....1010011
+fminm.s     | r | rs2(fp) rs1(fp) rd(fp)  | 0010100..........010.....1010011
+fmaxm.s     | r | rs2(fp) rs1(fp) rd(fp)  | 0010100..........011.....1010011
+fminm.d     | r | rs2(fp) rs1(fp) rd(fp)  | 0010101..........010.....1010011
+fmaxm.d     | r | rs2(fp) rs1(fp) rd(fp)  | 0010101..........011.....1010011
+fminm.h     | r | rs2(fp) rs1(fp) rd(fp)  | 0010110..........010.....1010011
+fmaxm.h     | r | rs2(fp) rs1(fp) rd(fp)  | 0010110..........011.....1010011
+fminm.q     | r | rs2(fp) rs1(fp) rd(fp)  | 0010111..........010.....1010011
+fmaxm.q     | r | rs2(fp) rs1(fp) rd(fp)  | 0010111..........011.....1010011
+fround.s    | r | rs1(fp) rm rd(fp)       | 010000000100.............1010011
+froundnx.s  | r | rs1(fp) rm rd(fp)       | 010000000101.............1010011
+fround.d    | r | rs1(fp) rm rd(fp)       | 010000100100.............1010011
+froundnx.d  | r | rs1(fp) rm rd(fp)       | 010000100101.............1010011
+fround.h    | r | rs1(fp) rm rd(fp)       | 010001000100.............1010011
+froundnx.h  | r | rs1(fp) rm rd(fp)       | 010001000101.............1010011
+fround.q    | r | rs1(fp) rm rd(fp)       | 010001100100.............1010011
+froundnx.q  | r | rs1(fp) rm rd(fp)       | 010001100101.............1010011
+fcvtmod.w.d | r | rs1(fp) rm rd           | 110000101000.....001.....1010011
+fleq.s      | r | rs2(fp) rs1(fp) rd      | 1010000..........100.....1010011
+fltq.s      | r | rs2(fp) rs1(fp) rd      | 1010000..........101.....1010011
+fleq.d      | r | rs2(fp) rs1(fp) rd      | 1010001..........100.....1010011
+fltq.d      | r | rs2(fp) rs1(fp) rd      | 1010001..........101.....1010011
+fleq.h      | r | rs2(fp) rs1(fp) rd      | 1010010..........100.....1010011
+fltq.h      | r | rs2(fp) rs1(fp) rd      | 1010010..........101.....1010011
+fleq.q      | r | rs2(fp) rs1(fp) rd      | 1010011..........100.....1010011
+fltq.q      | r | rs2(fp) rs1(fp) rd      | 1010011..........101.....1010011
diff --git a/core/ir/riscv64/isl/zicond.txt b/core/ir/riscv64/isl/zicond.txt
new file mode 100644
index 000000000..183d25bb3
--- /dev/null
+++ b/core/ir/riscv64/isl/zicond.txt
@@ -0,0 +1,5 @@
+# "Zicond" Standard Extension for Integer Conditional Operations.
+# Version 1.0
+
+czero.eqz | r | rs2 rs1 rd | 0000111..........101.....0110011
+czero.nez | r | rs2 rs1 rd | 0000111..........111.....0110011

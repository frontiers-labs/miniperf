From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: miniperf <miniperf@localhost>
Date: Sun, 6 Sep 2026 21:01:05 +0300
Subject: [PATCH 3/3] i#3544 RISC-V: decode the Zicond and Zfa instructions

Ubuntu's riscv64 glibc executes czero.eqz in _int_malloc and fli.d when
formatting a double, so a decoder without Zicond and Zfa turns any ordinary
program into SIGILL under DynamoRIO once it allocates or prints.

Zicond is two R-format instructions. Zfa needs one new field: fli takes a
constant-table index in the rs1 slot, reported as the index rather than the
constant it names. The half and quad forms are listed alongside single and
double: decoding does not depend on the host implementing Zfh or Q, and a
format the decoder does not expect would otherwise reach the application as
an illegal instruction.

RV32-only fmvh.x.d and fmvp.d.x are deliberately absent.
---
 core/ir/riscv64/codec.c            | 32 ++++++++++++++++++++++++++
 core/ir/riscv64/codec.h            |  4 ++++
 core/ir/riscv64/codec.py           | 10 +++++++++
 core/ir/riscv64/isl/README.md      |  1 +
 core/ir/riscv64/isl/zfa.txt        | 36 ++++++++++++++++++++++++++++++
 core/ir/riscv64/isl/zicond.txt     |  5 +++++
 make/CMake_riscv64_gen_codec.cmake |  2 ++
 7 files changed, 90 insertions(+)
 create mode 100644 core/ir/riscv64/isl/zfa.txt
 create mode 100644 core/ir/riscv64/isl/zicond.txt

diff --git a/core/ir/riscv64/codec.c b/core/ir/riscv64/codec.c
index f9bf31796..227aadf9a 100644
--- a/core/ir/riscv64/codec.c
+++ b/core/ir/riscv64/codec.c
@@ -1418,6 +1418,24 @@ decode_csh_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *or
     return true;
 }
 
+/* Decode the constant index of an fli instruction, which occupies the rs1
+ * slot:
+ * |31    20|19   15|14  12|11  7|6      0|
+ * |  ...   | index |  ... | rd  | opcode |
+ *           ^-----^
+ * The index selects one of 32 constants defined by the Zfa specification;
+ * the value is reported as-is rather than as the constant it names.
+ */
+static bool
+decode_fli_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig_pc,
+                    int idx, instr_t *out)
+{
+    int32_t imm = GET_FIELD(inst, 19, 15);
+    opnd_t opnd = opnd_add_flags(opnd_create_immed_int(imm, op_sz), DR_OPND_IMM_PRINT_DECIMAL);
+    instr_set_src(out, idx, opnd);
+    return true;
+}
+
 /* Array of operand decode functions indexed by riscv64_fld_t.
  *
  * NOTE: After benchmarking, perhaps this could be placed in the same section as
@@ -1500,6 +1518,7 @@ opnd_dec_func_t opnd_decoders[] = {
     [RISCV64_FLD_CLH_IMM] = decode_clh_imm_opnd,
     [RISCV64_FLD_CSB_IMM] = decode_csb_imm_opnd,
     [RISCV64_FLD_CSH_IMM] = decode_csh_imm_opnd,
+    [RISCV64_FLD_FLI_IMM] = decode_fli_imm_opnd,
     [RISCV64_FLD_I_S_RS1_DISP] = decode_v_s_rs1_disp_opnd,
 };
 
@@ -2989,6 +3008,18 @@ encode_csh_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_inf
     return true;
 }
 
+/* Encode the constant index of an fli instruction. See decode_fli_imm_opnd()
+ * for the field layout.
+ */
+static bool
+encode_fli_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_info_t *di)
+{
+    opnd_t opnd = instr_get_src(instr, idx);
+    int32_t imm = opnd_get_immed_int(opnd);
+    *out |= SET_FIELD(imm, 19, 15);
+    return true;
+}
+
 /* Array of operand encode functions indexed by riscv64_fld_t. */
 opnd_enc_func_t opnd_encoders[] = {
     [RISCV64_FLD_NONE] = encode_none_opnd,
@@ -3067,6 +3098,7 @@ opnd_enc_func_t opnd_encoders[] = {
     [RISCV64_FLD_CLH_IMM] = encode_clh_imm_opnd,
     [RISCV64_FLD_CSB_IMM] = encode_csb_imm_opnd,
     [RISCV64_FLD_CSH_IMM] = encode_csh_imm_opnd,
+    [RISCV64_FLD_FLI_IMM] = encode_fli_imm_opnd,
     [RISCV64_FLD_I_S_RS1_DISP] = encode_implicit_opnd,
 };
 
diff --git a/core/ir/riscv64/codec.h b/core/ir/riscv64/codec.h

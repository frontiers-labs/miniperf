     RISCV64_FLD_CNT, /* Keep this last */
 } riscv64_fld_t;
 
diff --git a/core/ir/riscv64/codec.py b/core/ir/riscv64/codec.py
index d43645236..5e1e24c3b 100755
--- a/core/ir/riscv64/codec.py
+++ b/core/ir/riscv64/codec.py
@@ -849,6 +849,16 @@ class Field(str, Enum):
                'The register-relative memory location of a 2-byte access '
                '(reg+imm: imm & 0x1 == 0).'
                )
+    # Zfa extension fields.
+    FLI_IMM = (78,
+               'imm',
+               False,
+               False,
+               True,
+               'OPSZ_5b',
+               '',
+               'The constant index in an FLI instruction (inst[19:15]).'
+               )
 
     def __str__(self) -> str:
         return self.name.lower().replace("fp", "(fp)")

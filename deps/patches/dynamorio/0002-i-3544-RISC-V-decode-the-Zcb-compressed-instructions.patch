     return true;
 }
 
+/* Encode the base register and offset immediate of the c.lbu and c.sb
+ * instructions. See decode_clb_imm_opnd() for the field layout.
+ */
+static bool
+encode_clb_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_info_t *di)
+{
+    opnd_t opnd = instr_get_src(instr, idx);
+    uint32_t reg = opnd_get_base(opnd) - DR_REG_X8;
+    int32_t imm = opnd_get_disp(opnd);
+    *out |= SET_FIELD(reg, 9, 7) | SET_FIELD(imm >> 1, 5, 5) | SET_FIELD(imm, 6, 6);
+    return true;
+}
+
+/* Encode the base register and offset immediate of the c.lh, c.lhu and c.sh
+ * instructions. See decode_clh_imm_opnd() for the field layout.
+ */
+static bool
+encode_clh_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_info_t *di)
+{
+    opnd_t opnd = instr_get_src(instr, idx);
+    uint32_t reg = opnd_get_base(opnd) - DR_REG_X8;
+    int32_t imm = opnd_get_disp(opnd);
+    *out |= SET_FIELD(reg, 9, 7) | SET_FIELD(imm >> 1, 5, 5);
+    return true;
+}
+
+/* Same as encode_clb_imm_opnd(), but the memory location is a destination. */
+static bool
+encode_csb_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_info_t *di)
+{
+    opnd_t opnd = instr_get_dst(instr, idx);
+    uint32_t reg = opnd_get_base(opnd) - DR_REG_X8;
+    int32_t imm = opnd_get_disp(opnd);
+    *out |= SET_FIELD(reg, 9, 7) | SET_FIELD(imm >> 1, 5, 5) | SET_FIELD(imm, 6, 6);
+    return true;
+}
+
+/* Same as encode_clh_imm_opnd(), but the memory location is a destination. */
+static bool
+encode_csh_imm_opnd(instr_t *instr, byte *pc, int idx, uint32_t *out, decode_info_t *di)
+{
+    opnd_t opnd = instr_get_dst(instr, idx);
+    uint32_t reg = opnd_get_base(opnd) - DR_REG_X8;
+    int32_t imm = opnd_get_disp(opnd);
+    *out |= SET_FIELD(reg, 9, 7) | SET_FIELD(imm >> 1, 5, 5);
+    return true;
+}
+
 /* Array of operand encode functions indexed by riscv64_fld_t. */
 opnd_enc_func_t opnd_encoders[] = {
     [RISCV64_FLD_NONE] = encode_none_opnd,
@@ -2916,6 +3063,10 @@ opnd_enc_func_t opnd_encoders[] = {
     [RISCV64_FLD_VS1] = encode_vs1_opnd,
     [RISCV64_FLD_VS2] = encode_vs2_opnd,
     [RISCV64_FLD_VS3] = encode_vs3_opnd,

@@ -1588,6 +1682,7 @@ get_rvc_instr_info(uint32_t inst, int xlen)
     int funct2 = GET_FIELD(inst, 11, 10);
     int bit12 = BIT(inst, 12);
     int funct3 = GET_FIELD(inst, 6, 5);
+    int bit4to2 = GET_FIELD(inst, 4, 2);
     int bit6to2 = GET_FIELD(inst, 6, 2);

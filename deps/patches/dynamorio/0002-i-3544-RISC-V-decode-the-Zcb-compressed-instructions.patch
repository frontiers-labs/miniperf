diff --git a/core/ir/riscv64/codec.c b/core/ir/riscv64/codec.c
index 29f18a695..f9bf31796 100644
--- a/core/ir/riscv64/codec.c
+++ b/core/ir/riscv64/codec.c
@@ -1353,6 +1353,71 @@ decode_simm5_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig
     return true;
 }
 
+/* Decode the base register and offset immediate of the c.lbu and c.sb
+ * instructions:
+ * |15 13|12 10|9    7|6      5|4   2|1      0|
+ * | ... | ... | rs1' | imm[0] | ... | opcode |
+ *                     | imm[1] |
+ *              ^----^ ^-------^
+ * Note that the immediate bits are swapped with respect to every other
+ * compressed memory access: inst[6] is imm[0] and inst[5] is imm[1].
+ */
+static bool
+decode_clb_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig_pc,
+                    int idx, instr_t *out)
+{
+    reg_t reg = DR_REG_X8 + GET_FIELD(inst, 9, 7);
+    int32_t imm = (BIT(inst, 5) << 1) | BIT(inst, 6);
+    opnd_t opnd = opnd_add_flags(opnd_create_base_disp(reg, DR_REG_NULL, 0, imm, OPSZ_1),
+                                 DR_OPND_IMM_PRINT_DECIMAL);
+    instr_set_src(out, idx, opnd);
+    return true;
+}
+
+/* Decode the base register and offset immediate of the c.lh, c.lhu and c.sh
+ * instructions:
+ * |15 13|12 10|9    7|6|5      |4   2|1      0|
+ * | ... | ... | rs1' | | imm[1] | ... | opcode |
+ *              ^----^   ^-------^
+ */
+static bool
+decode_clh_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig_pc,
+                    int idx, instr_t *out)
+{
+    reg_t reg = DR_REG_X8 + GET_FIELD(inst, 9, 7);
+    int32_t imm = BIT(inst, 5) << 1;
+    opnd_t opnd = opnd_add_flags(opnd_create_base_disp(reg, DR_REG_NULL, 0, imm, OPSZ_2),
+                                 DR_OPND_IMM_PRINT_DECIMAL);
+    instr_set_src(out, idx, opnd);
+    return true;
+}
+
+/* Same as decode_clb_imm_opnd(), but the memory location is a destination. */
+static bool
+decode_csb_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig_pc,
+                    int idx, instr_t *out)
+{
+    reg_t reg = DR_REG_X8 + GET_FIELD(inst, 9, 7);
+    int32_t imm = (BIT(inst, 5) << 1) | BIT(inst, 6);
+    opnd_t opnd = opnd_add_flags(opnd_create_base_disp(reg, DR_REG_NULL, 0, imm, OPSZ_1),
+                                 DR_OPND_IMM_PRINT_DECIMAL);
+    instr_set_dst(out, idx, opnd);
+    return true;
+}
+
+/* Same as decode_clh_imm_opnd(), but the memory location is a destination. */
+static bool
+decode_csh_imm_opnd(dcontext_t *dc, uint32_t inst, int op_sz, byte *pc, byte *orig_pc,
+                    int idx, instr_t *out)
+{
+    reg_t reg = DR_REG_X8 + GET_FIELD(inst, 9, 7);
+    int32_t imm = BIT(inst, 5) << 1;
+    opnd_t opnd = opnd_add_flags(opnd_create_base_disp(reg, DR_REG_NULL, 0, imm, OPSZ_2),
+                                 DR_OPND_IMM_PRINT_DECIMAL);
+    instr_set_dst(out, idx, opnd);
+    return true;
+}
+
 /* Array of operand decode functions indexed by riscv64_fld_t.
  *
  * NOTE: After benchmarking, perhaps this could be placed in the same section as
@@ -1431,6 +1496,10 @@ opnd_dec_func_t opnd_decoders[] = {
     [RISCV64_FLD_VS1] = decode_vs1_opnd,
     [RISCV64_FLD_VS2] = decode_vs2_opnd,
     [RISCV64_FLD_VS3] = decode_vs3_opnd,
+    [RISCV64_FLD_CLB_IMM] = decode_clb_imm_opnd,
+    [RISCV64_FLD_CLH_IMM] = decode_clh_imm_opnd,
+    [RISCV64_FLD_CSB_IMM] = decode_csb_imm_opnd,
+    [RISCV64_FLD_CSH_IMM] = decode_csh_imm_opnd,
     [RISCV64_FLD_I_S_RS1_DISP] = decode_v_s_rs1_disp_opnd,
 };
 

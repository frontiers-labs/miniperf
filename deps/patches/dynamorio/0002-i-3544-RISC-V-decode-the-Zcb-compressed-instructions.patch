-match_op_1(int funct, int funct2, int funct3, int bit11to7, int bit12, bool rv32,
-           bool rv64)
+match_op_1(int funct, int funct2, int funct3, int bit4to2, int bit11to7, int bit12,
+           bool rv32, bool rv64)
 {
     switch (funct) {
     case 0:
@@ -1513,7 +1593,21 @@ match_op_1(int funct, int funct2, int funct3, int bit11to7, int bit12, bool rv32
                 switch (funct3) {
                 case 0: return &instr_infos[OP_c_subw];
                 case 1: return &instr_infos[OP_c_addw];
